# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role klíč. NIKDY nesmí opustit server (žádné NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# E-maily o rezervacích — https://resend.com (zdarma 3 000 e-mailů/měsíc)
# Bez klíče web funguje dál, e-maily se jen nepošlou (zaloguje se varování).
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
BOOKING_FROM_EMAIL="Honza Detailing <rezervace@hdetailing.cz>"
ADMIN_NOTIFY_EMAIL=info@hdetailing.cz

# ---------------------------------------------------------------------------
# Veřejná adresa webu (odkazy v e-mailech, přesměrování po přihlášení)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
